# Copy to .env and adjust. All settings are optional; defaults run the local demo.
SAQR_DATA_DIR=var
SAQR_HOST=0.0.0.0
SAQR_PORT=8000
# Visual encoder: perceptual (no ML deps) | dino (needs `pip install saqr[ml]`)
SAQR_VISUAL_ENCODER=perceptual
SAQR_DINO_MODEL=facebook/dinov3-vits16-pretrain-lvd1689m
# Certificate Transparency sources: replay | ctlogs | certstream | hybrid (live logs + injected demo domains)
SAQR_CT_SOURCE=replay
SAQR_CERTSTREAM_URL=wss://certstream.calidog.io
# RFC 3161 time-stamp authorities tried in order; falls back to a locally signed timestamp.
SAQR_TSA_URLS=https://freetsa.org/tsr,http://timestamp.digicert.com
# Connectors: simulate (default, logs realistic payloads) | live (uses configured endpoints)
SAQR_CONNECTOR_MODE=simulate
# Baselines used for the 70% / 50% comparison (hours). Documented in docs/metrics.md
SAQR_BASELINE_TTI_HOURS=9
SAQR_BASELINE_EXPOSURE_HOURS=48
